DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance_assistant?schema=public"
OPENAI_API_KEY=""
# Optional: choose a Responses API model with function calling support.
OPENAI_CHAT_MODEL="gpt-6-luna"
OPENAI_CLASSIFICATION_MODEL="gpt-6-luna"
OPENAI_TRANSCRIBE_MODEL="gpt-transcribe"
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
OPENAI_VOICE="cedar"
# Default UI mode; both paths remain available for comparison.
VOICE_RUNTIME_MODE="legacy"
OPENAI_REALTIME_MODEL="gpt-realtime-2.1-mini"
OPENAI_REALTIME_VOICE="marin"
# Semantic directionality classifier only; no financial tools or calculations.
OPENAI_REALTIME_FILTER_MODEL="gpt-6-luna"
REALTIME_IDLE_TIMEOUT_MS=60000
REALTIME_MAX_SESSION_MS=600000
# Phase 2 connectivity only; never used as the default voice mode.
GPT_LIVE_ENABLED=false
# Isolated, read-only Phase 0 POC; also requires NODE_ENV=development.
GPT_LIVE_RESPONSES_DELEGATION_EXPERIMENT=false
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_VOICE=vesper
LIVE_IDLE_TIMEOUT_MS=60000
LIVE_MAX_SESSION_MS=600000
